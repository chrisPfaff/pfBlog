---
export const prerender = false;
import '../styles/global.scss';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Iron Log | Christopher Pfaff</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <div class="tracker-app">
    <!-- PIN Screen -->
    <div class="pin-screen" id="pin-screen">
      <div class="pin-content">
        <h1 class="pin-title">Iron Log</h1>
        <div class="accent-line"></div>
        <p class="pin-subtitle">Enter your PIN to continue</p>
        <input type="password" id="pin-input" placeholder="••••" maxlength="8" inputmode="numeric" />
        <button class="btn-primary" id="pin-submit">Enter</button>
        <div class="pin-error" id="pin-error"></div>
      </div>
    </div>

    <!-- Main App -->
    <div class="tracker-main" id="tracker-main">
      <header class="tracker-header">
        <div class="header-content">
          <a href="/" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
          </a>
          <h1>Iron Log</h1>
        </div>
      </header>

      <!-- View Toggle -->
      <div class="view-toggle">
        <button class="view-btn active" data-view="log">Log Workout</button>
        <button class="view-btn" data-view="history">History</button>
      </div>

      <!-- Log View -->
      <div class="view-panel active" id="log-view">
        <div class="date-picker">
          <label for="workout-date">Session date</label>
          <input type="date" id="workout-date" />
        </div>

        <div class="day-tabs" id="day-tabs"></div>
        <div class="exercises" id="exercises"></div>

        <div class="save-area">
          <button class="btn-primary save-btn" id="save-btn">Log Workout</button>
          <div class="save-note" id="save-note"></div>
        </div>
      </div>

      <!-- History View -->
      <div class="view-panel" id="history-view">
        <div class="history-grid" id="history-grid"></div>
        <div class="history-empty" id="history-empty">No workouts logged yet</div>
      </div>
    </div>
  </div>

  <style>
    .tracker-app {
      min-height: 100vh;
    }

    /* PIN Screen */
    .pin-screen {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .pin-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      animation: fadeUp 0.8s ease-out;
    }

    .pin-title {
      font-size: clamp(2rem, 6vw, 3rem);
      font-weight: 700;
      background: linear-gradient(135deg, #ffffff 0%, rgba(255, 255, 255, 0.8) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 1.5rem;
    }

    .pin-subtitle {
      color: rgba(255, 255, 255, 0.5);
      font-size: 1rem;
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .pin-screen input {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #fff;
      font-size: 1.5rem;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      width: 140px;
      text-align: center;
      letter-spacing: 0.5em;
      margin-bottom: 1.5rem;
      transition: border-color 0.3s ease;
    }

    .pin-screen input:focus {
      outline: none;
      border-color: #8b5cf6;
    }

    .pin-error {
      color: #ef4444;
      font-size: 0.875rem;
      margin-top: 1rem;
      min-height: 1.25rem;
    }

    /* Buttons */
    .btn-primary {
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #fff;
      font-weight: 600;
      font-size: 1rem;
      border: none;
      border-radius: 8px;
      padding: 0.875rem 2rem;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(139, 92, 246, 0.3);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .btn-primary.saved {
      background: linear-gradient(135deg, #10b981, #059669);
    }

    /* Main Tracker */
    .tracker-main {
      display: none;
      max-width: 640px;
      margin: 0 auto;
      padding: 1.5rem;
      padding-bottom: 6rem;
    }

    .tracker-main.active {
      display: block;
      animation: fadeUp 0.5s ease-out;
    }

    .tracker-header {
      margin-bottom: 2rem;
    }

    .header-content {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .back-link {
      color: rgba(255, 255, 255, 0.5);
      transition: color 0.3s ease;
    }

    .back-link:hover {
      color: #8b5cf6;
    }

    .tracker-header h1 {
      font-size: 1.75rem;
      font-weight: 700;
      background: linear-gradient(135deg, #ffffff 0%, rgba(255, 255, 255, 0.8) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* View Toggle */
    .view-toggle {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 2rem;
      background: rgba(255, 255, 255, 0.05);
      padding: 0.25rem;
      border-radius: 10px;
    }

    .view-btn {
      flex: 1;
      background: transparent;
      border: none;
      color: rgba(255, 255, 255, 0.5);
      font-size: 0.875rem;
      font-weight: 500;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .view-btn.active {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
    }

    .view-btn:hover:not(.active) {
      color: rgba(255, 255, 255, 0.8);
    }

    /* View Panels */
    .view-panel {
      display: none;
    }

    .view-panel.active {
      display: block;
    }

    /* Date Picker */
    .date-picker {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .date-picker label {
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.5);
    }

    .date-picker input {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #fff;
      font-family: inherit;
      font-size: 0.875rem;
      padding: 0.5rem 0.75rem;
      border-radius: 6px;
    }

    .date-picker input:focus {
      outline: none;
      border-color: #8b5cf6;
    }

    /* Day Tabs */
    .day-tabs {
      display: flex;
      gap: 0.25rem;
      margin-bottom: 1.5rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .day-tab {
      background: transparent;
      border: none;
      color: rgba(255, 255, 255, 0.5);
      font-size: 0.875rem;
      font-weight: 500;
      padding: 0.625rem 1rem;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.3s ease;
      white-space: nowrap;
    }

    .day-tab.active {
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #fff;
    }

    .day-tab:hover:not(.active) {
      background: rgba(255, 255, 255, 0.05);
      color: rgba(255, 255, 255, 0.8);
    }

    /* Exercises */
    .exercise {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    .ex-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.75rem;
    }

    .ex-name {
      font-weight: 600;
      font-size: 1rem;
      color: #fff;
    }

    .ex-target {
      font-size: 0.75rem;
      color: #8b5cf6;
      background: rgba(139, 92, 246, 0.15);
      padding: 0.25rem 0.625rem;
      border-radius: 4px;
      white-space: nowrap;
    }

    .ex-last {
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 0.75rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .ex-status {
      font-size: 0.8rem;
      padding: 0.625rem 0.875rem;
      border-radius: 8px;
      margin-bottom: 1.25rem;
      line-height: 1.4;
    }

    .ex-status.good {
      background: rgba(16, 185, 129, 0.12);
      color: #34d399;
      border-left: 3px solid #10b981;
    }

    .ex-status.warn {
      background: rgba(245, 158, 11, 0.12);
      color: #fbbf24;
      border-left: 3px solid #f59e0b;
    }

    .ex-status.neutral {
      background: rgba(255, 255, 255, 0.04);
      color: rgba(255, 255, 255, 0.6);
      border-left: 3px solid rgba(255, 255, 255, 0.2);
    }

    .assist-row {
      margin-bottom: 1rem;
    }

    .assist-row input {
      width: 100%;
    }

    /* Set Labels */
    .sets-header {
      display: grid;
      grid-template-columns: 32px 1fr 1fr;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
      padding: 0 0.25rem;
    }

    .sets-header.single {
      grid-template-columns: 32px 1fr;
    }

    .sets-header span {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: rgba(255, 255, 255, 0.35);
      font-weight: 500;
    }

    .sets {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }

    .set-row {
      display: grid;
      grid-template-columns: 32px 1fr 1fr;
      gap: 0.75rem;
      align-items: center;
    }

    .set-row.time,
    .set-row.bw {
      grid-template-columns: 32px 1fr;
    }

    .set-idx {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.5);
      background: rgba(255, 255, 255, 0.05);
      border-radius: 6px;
    }

    .exercise input[type="number"] {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #fff;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 500;
      padding: 0.625rem 0.75rem;
      border-radius: 6px;
      width: 100%;
    }

    .exercise input[type="number"]:focus {
      outline: none;
      border-color: #8b5cf6;
    }

    .exercise input::placeholder {
      color: rgba(255, 255, 255, 0.25);
    }

    /* Save Area */
    .save-area {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 1rem;
      background: linear-gradient(to top, #0a0a0b 60%, transparent);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .save-btn {
      width: 100%;
      max-width: 400px;
    }

    .save-note {
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.5);
      min-height: 1rem;
    }

    /* History View */
    .history-grid {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .history-empty {
      text-align: center;
      color: rgba(255, 255, 255, 0.4);
      padding: 3rem 1rem;
      display: none;
    }

    .history-empty.show {
      display: block;
    }

    .history-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .history-date {
      font-weight: 600;
      color: #fff;
    }

    .history-day {
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.5);
      margin-top: 0.25rem;
    }

    .history-badge {
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.375rem 0.75rem;
      border-radius: 20px;
    }

    /* Animations */
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <script>
    const DAYS = {
      upperA: {
        label: 'Upper A',
        exercises: [
          { id: 'ua-bench', name: 'Bench Press', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'ua-latpull', name: 'Lat Pulldown', sets: 3, min: 10, max: 12, type: 'weight' },
          { id: 'ua-shoulderpress', name: 'Seated DB Shoulder Press', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'ua-row', name: 'Chest-Supported Row', sets: 3, min: 10, max: 12, type: 'weight' },
          { id: 'ua-latraise', name: 'Cable Lateral Raise', sets: 2, min: 12, max: 15, type: 'weight' },
          { id: 'ua-curl', name: 'Bicep Curl', sets: 2, min: 10, max: 12, type: 'weight' },
          { id: 'ua-pushdown', name: 'Tricep Pushdown', sets: 2, min: 10, max: 12, type: 'weight' },
        ]
      },
      lowerA: {
        label: 'Lower A',
        exercises: [
          { id: 'la-squat', name: 'Barbell Back Squat', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'la-rdl', name: 'Romanian Deadlift', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'la-legpress', name: 'Leg Press', sets: 2, min: 10, max: 12, type: 'weight' },
          { id: 'la-legcurl', name: 'Leg Curl', sets: 3, min: 10, max: 12, type: 'weight' },
          { id: 'la-calf', name: 'Standing Calf Raise', sets: 3, min: 12, max: 15, type: 'weight' },
          { id: 'la-plank', name: 'Weighted Plank', sets: 2, min: 30, max: 45, type: 'time' },
        ]
      },
      upperB: {
        label: 'Upper B',
        exercises: [
          { id: 'ub-incline', name: 'Incline DB Press', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'ub-cablerow', name: 'Seated Cable Row', sets: 3, min: 10, max: 12, type: 'weight' },
          { id: 'ub-machinepress', name: 'Machine Shoulder Press', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'ub-pullup', name: 'Pull-Ups', sets: 3, min: 6, max: 12, type: 'bodyweight' },
          { id: 'ub-reardelt', name: 'Rear Delt Fly', sets: 2, min: 12, max: 15, type: 'weight' },
          { id: 'ub-hammer', name: 'Hammer Curl', sets: 2, min: 10, max: 12, type: 'weight' },
          { id: 'ub-tricepext', name: 'Overhead Tricep Extension', sets: 2, min: 10, max: 12, type: 'weight' },
        ]
      },
      lowerB: {
        label: 'Lower B',
        exercises: [
          { id: 'lb-deadlift', name: 'Deadlift', sets: 3, min: 6, max: 8, type: 'weight' },
          { id: 'lb-frontsquat', name: 'Front / Goblet Squat', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'lb-lunge', name: 'Walking Lunges', sets: 2, min: 10, max: 12, type: 'weight' },
          { id: 'lb-legext', name: 'Leg Extension', sets: 3, min: 10, max: 12, type: 'weight' },
          { id: 'lb-seatedcalf', name: 'Seated Calf Raise', sets: 3, min: 12, max: 15, type: 'weight' },
          { id: 'lb-kneeraise', name: 'Hanging Knee Raise', sets: 2, min: 10, max: 15, type: 'bodyweight' },
        ]
      },
    };

    let pin = sessionStorage.getItem('workout-pin') || '';
    let log = {};
    let activeDay = 'upperA';
    let currentView = 'log';

    const pinScreen = document.getElementById('pin-screen');
    const pinInput = document.getElementById('pin-input');
    const pinSubmit = document.getElementById('pin-submit');
    const pinError = document.getElementById('pin-error');
    const trackerMain = document.getElementById('tracker-main');
    const tabsEl = document.getElementById('day-tabs');
    const exEl = document.getElementById('exercises');
    const dateInput = document.getElementById('workout-date');
    const saveBtn = document.getElementById('save-btn');
    const noteEl = document.getElementById('save-note');
    const historyGrid = document.getElementById('history-grid');
    const historyEmpty = document.getElementById('history-empty');
    const viewBtns = document.querySelectorAll('.view-btn');
    const logView = document.getElementById('log-view');
    const historyView = document.getElementById('history-view');

    async function checkAuth() {
      if (!pin) return false;
      try {
        const res = await fetch('/api/workout', {
          headers: { 'x-workout-pin': pin }
        });
        return res.ok;
      } catch {
        return false;
      }
    }

    async function loadLog() {
      try {
        const res = await fetch('/api/workout', {
          headers: { 'x-workout-pin': pin }
        });
        if (!res.ok) throw new Error('Failed to load');
        const data = await res.json();
        log = data.value ? (typeof data.value === 'string' ? JSON.parse(data.value) : data.value) : {};
      } catch {
        log = {};
      }
      render();
      renderHistory();
    }

    async function saveLog() {
      try {
        const res = await fetch('/api/workout', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-workout-pin': pin
          },
          body: JSON.stringify({ value: JSON.stringify(log) })
        });
        if (!res.ok) throw new Error('Failed to save');
        return true;
      } catch {
        noteEl.textContent = 'Could not save — try again.';
        return false;
      }
    }

    function lastEntry(exId) {
      const arr = log[exId];
      if (!arr || !arr.length) return null;
      return arr[arr.length - 1];
    }

    function formatLast(ex, entry) {
      if (!entry) return 'No previous session';
      const parts = entry.sets.map(s => {
        if (ex.type === 'weight') return `${s.weight || '–'}×${s.reps || '–'}`;
        if (ex.type === 'bodyweight') return `${s.reps || '–'}${entry.assist ? ` (+${entry.assist}lb)` : ''}`;
        if (ex.type === 'time') return `${s.secs || '–'}s`;
      });
      return `Last (${entry.date}): ${parts.join(', ')}`;
    }

    function computeStatus(ex, entry) {
      if (!entry) return { text: 'Pick a weight you can hit the low end with 1-2 reps in reserve.', level: 'neutral' };
      const metrics = entry.sets.map(s => ex.type === 'time' ? Number(s.secs) : Number(s.reps)).filter(n => !isNaN(n));
      if (!metrics.length) return { text: 'No sets recorded last time.', level: 'neutral' };
      const allAtMax = metrics.every(m => m >= ex.max);
      const anyBelowMin = metrics.some(m => m < ex.min);
      if (allAtMax) {
        const bump = ex.type === 'time' ? 'add 5-10s or load it' : (ex.type === 'bodyweight' ? 'add weight or reduce assist' : 'add ~5lbs');
        return { text: `Hit top of range — ${bump} next time.`, level: 'good' };
      }
      if (anyBelowMin) {
        return { text: 'Under range — same load, focus on reps.', level: 'warn' };
      }
      return { text: 'In range — try to add a rep where you can.', level: 'neutral' };
    }

    function render() {
      document.querySelectorAll('#day-tabs .day-tab').forEach((btn, i) => {
        btn.classList.toggle('active', Object.keys(DAYS)[i] === activeDay);
      });

      exEl.innerHTML = '';
      DAYS[activeDay].exercises.forEach(ex => {
        const entry = lastEntry(ex.id);
        const status = computeStatus(ex, entry);

        const wrap = document.createElement('div');
        wrap.className = 'exercise';
        wrap.dataset.exId = ex.id;
        wrap.dataset.type = ex.type;

        const targetText = ex.type === 'time'
          ? `${ex.sets} × ${ex.min}-${ex.max}s`
          : `${ex.sets} × ${ex.min}-${ex.max}`;

        wrap.innerHTML = `
          <div class="ex-header">
            <div class="ex-name">${ex.name}</div>
            <div class="ex-target">${targetText}</div>
          </div>
          <div class="ex-last">${formatLast(ex, entry)}</div>
          <div class="ex-status ${status.level}">${status.text}</div>
        `;

        if (ex.type === 'bodyweight') {
          const assistRow = document.createElement('div');
          assistRow.className = 'assist-row';
          assistRow.innerHTML = `<input type="number" placeholder="Added/assist lbs (optional)" data-role="assist" />`;
          wrap.appendChild(assistRow);
        }

        // Add column headers
        const headerRow = document.createElement('div');
        if (ex.type === 'weight') {
          headerRow.className = 'sets-header';
          headerRow.innerHTML = `<span>Set</span><span>Weight</span><span>Reps</span>`;
        } else if (ex.type === 'bodyweight') {
          headerRow.className = 'sets-header single';
          headerRow.innerHTML = `<span>Set</span><span>Reps</span>`;
        } else {
          headerRow.className = 'sets-header single';
          headerRow.innerHTML = `<span>Set</span><span>Time</span>`;
        }
        wrap.appendChild(headerRow);

        const setsWrap = document.createElement('div');
        setsWrap.className = 'sets';
        for (let i = 1; i <= ex.sets; i++) {
          const row = document.createElement('div');
          if (ex.type === 'weight') {
            row.className = 'set-row';
            row.innerHTML = `
              <div class="set-idx">${i}</div>
              <input type="number" inputmode="decimal" data-role="weight" data-set="${i}" />
              <input type="number" inputmode="numeric" data-role="reps" data-set="${i}" />
            `;
          } else if (ex.type === 'bodyweight') {
            row.className = 'set-row bw';
            row.innerHTML = `
              <div class="set-idx">${i}</div>
              <input type="number" inputmode="numeric" data-role="reps" data-set="${i}" />
            `;
          } else {
            row.className = 'set-row time';
            row.innerHTML = `
              <div class="set-idx">${i}</div>
              <input type="number" inputmode="numeric" data-role="secs" data-set="${i}" />
            `;
          }
          setsWrap.appendChild(row);
        }
        wrap.appendChild(setsWrap);
        exEl.appendChild(wrap);
      });
    }

    function renderHistory() {
      const sessions = [];
      const seenDates = new Set();

      Object.entries(log).forEach(([exId, entries]) => {
        entries.forEach(entry => {
          if (!seenDates.has(entry.date)) {
            seenDates.add(entry.date);
            const dayKey = Object.keys(DAYS).find(k =>
              DAYS[k].exercises.some(e => e.id === exId)
            );
            sessions.push({
              date: entry.date,
              dayLabel: dayKey ? DAYS[dayKey].label : 'Workout'
            });
          }
        });
      });

      sessions.sort((a, b) => new Date(b.date) - new Date(a.date));

      if (sessions.length === 0) {
        historyGrid.innerHTML = '';
        historyEmpty.classList.add('show');
        return;
      }

      historyEmpty.classList.remove('show');
      historyGrid.innerHTML = sessions.map(s => {
        const dateObj = new Date(s.date + 'T00:00:00');
        const formatted = dateObj.toLocaleDateString('en-US', {
          weekday: 'short',
          month: 'short',
          day: 'numeric'
        });
        return `
          <div class="history-item">
            <div>
              <div class="history-date">${formatted}</div>
              <div class="history-day">${s.dayLabel}</div>
            </div>
            <div class="history-badge">${s.dayLabel}</div>
          </div>
        `;
      }).join('');
    }

    function initTabs() {
      tabsEl.innerHTML = '';
      Object.keys(DAYS).forEach(key => {
        const btn = document.createElement('button');
        btn.className = 'day-tab' + (key === activeDay ? ' active' : '');
        btn.textContent = DAYS[key].label;
        btn.onclick = () => { activeDay = key; render(); };
        tabsEl.appendChild(btn);
      });
    }

    function switchView(view) {
      currentView = view;
      viewBtns.forEach(btn => btn.classList.toggle('active', btn.dataset.view === view));
      logView.classList.toggle('active', view === 'log');
      historyView.classList.toggle('active', view === 'history');
    }

    async function showApp() {
      pinScreen.style.display = 'none';
      trackerMain.classList.add('active');
      dateInput.value = new Date().toISOString().slice(0, 10);
      initTabs();
      await loadLog();
    }

    viewBtns.forEach(btn => {
      btn.addEventListener('click', () => switchView(btn.dataset.view));
    });

    pinSubmit.addEventListener('click', async () => {
      pin = pinInput.value;
      if (!pin) {
        pinError.textContent = 'Enter a PIN';
        return;
      }
      pinError.textContent = 'Checking...';
      const valid = await checkAuth();
      if (valid) {
        sessionStorage.setItem('workout-pin', pin);
        showApp();
      } else {
        pinError.textContent = 'Invalid PIN';
      }
    });

    pinInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') pinSubmit.click();
    });

    saveBtn.addEventListener('click', async () => {
      const date = dateInput.value || new Date().toISOString().slice(0, 10);
      let loggedAny = false;

      document.querySelectorAll('#exercises .exercise').forEach(wrap => {
        const exId = wrap.dataset.exId;
        const type = wrap.dataset.type;
        const sets = [];
        let assist = null;

        if (type === 'bodyweight') {
          const assistInput = wrap.querySelector('[data-role=assist]');
          if (assistInput && assistInput.value) assist = assistInput.value;
        }

        const setRows = wrap.querySelectorAll('.set-row');
        setRows.forEach(row => {
          if (type === 'weight') {
            const w = row.querySelector('[data-role=weight]').value;
            const r = row.querySelector('[data-role=reps]').value;
            if (w || r) sets.push({ weight: w, reps: r });
          } else if (type === 'bodyweight') {
            const r = row.querySelector('[data-role=reps]').value;
            if (r) sets.push({ reps: r });
          } else {
            const s = row.querySelector('[data-role=secs]').value;
            if (s) sets.push({ secs: s });
          }
        });

        if (sets.length) {
          loggedAny = true;
          if (!log[exId]) log[exId] = [];
          const entry = { date, sets };
          if (assist) entry.assist = assist;
          log[exId].push(entry);
        }
      });

      if (!loggedAny) {
        noteEl.textContent = 'Fill in at least one set.';
        return;
      }

      const saved = await saveLog();
      if (saved) {
        saveBtn.classList.add('saved');
        saveBtn.textContent = 'Logged!';
        noteEl.textContent = `Saved ${DAYS[activeDay].label} for ${date}`;
        setTimeout(() => {
          saveBtn.classList.remove('saved');
          saveBtn.textContent = 'Log Workout';
        }, 1500);
        render();
        renderHistory();
      }
    });

    (async () => {
      if (pin) {
        const valid = await checkAuth();
        if (valid) {
          showApp();
        } else {
          sessionStorage.removeItem('workout-pin');
          pin = '';
        }
      }
    })();
  </script>
</body>
</html>
