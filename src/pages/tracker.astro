---
export const prerender = false;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Iron Log | Christopher Pfaff</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div id="pin-screen">
    <h1>Iron Log</h1>
    <div class="accent-line"></div>
    <p>Enter your PIN to continue</p>
    <input type="password" id="pin-input" placeholder="••••" maxlength="8" inputmode="numeric" />
    <button id="pin-submit">Enter</button>
    <div id="pin-error"></div>
  </div>

  <div id="app">
    <header>
      <a href="/" id="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </a>
      <h1>Iron Log</h1>
    </header>

    <div id="view-toggle">
      <button class="active" data-view="log">Log Workout</button>
      <button data-view="history">History</button>
    </div>

    <div id="log-view" class="view active">
      <div id="date-row">
        <label>Session date</label>
        <input type="date" id="workout-date" />
      </div>

      <div id="day-tabs"></div>
      <div id="exercises"></div>

      <div id="save-area">
        <div id="save-buttons">
          <button id="save-btn">Log Workout</button>
          <button id="cancel-btn" style="display: none;">Cancel</button>
        </div>
        <div id="save-note"></div>
      </div>
    </div>

    <div id="history-view" class="view">
      <div id="history-list"></div>
      <div id="history-empty">No workouts logged yet</div>
    </div>
  </div>

  <style is:global>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      background: #0a0a0b;
      color: #fff;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* PIN Screen */
    #pin-screen {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    #pin-screen h1 {
      font-size: 2.5rem;
      font-weight: 700;
      background: linear-gradient(135deg, #fff, rgba(255,255,255,0.8));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 1.5rem;
    }

    #pin-screen .accent-line {
      width: 60px;
      height: 3px;
      background: linear-gradient(90deg, #6366f1, #8b5cf6);
      border-radius: 2px;
    }

    #pin-screen p {
      color: rgba(255,255,255,0.5);
      margin: 1.5rem 0;
    }

    #pin-screen input {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.15);
      color: #fff;
      font-size: 1.5rem;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      width: 140px;
      text-align: center;
      letter-spacing: 0.5em;
      margin-bottom: 1.5rem;
    }

    #pin-screen input:focus {
      outline: none;
      border-color: #8b5cf6;
    }

    #pin-screen button {
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #fff;
      font-weight: 600;
      font-size: 1rem;
      border: none;
      border-radius: 8px;
      padding: 0.875rem 2.5rem;
      cursor: pointer;
    }

    #pin-error {
      color: #ef4444;
      font-size: 0.875rem;
      margin-top: 1rem;
      min-height: 1.25rem;
    }

    /* Main App */
    #app {
      display: none;
      max-width: 600px;
      margin: 0 auto;
      padding: 1.5rem;
      padding-bottom: 120px;
    }

    #app.active {
      display: block;
    }

    #app header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    #back-link {
      color: rgba(255,255,255,0.5);
      text-decoration: none;
    }

    #back-link:hover {
      color: #8b5cf6;
    }

    #app header h1 {
      font-size: 1.75rem;
      font-weight: 700;
    }

    /* View Toggle */
    #view-toggle {
      display: flex;
      background: rgba(255,255,255,0.05);
      border-radius: 12px;
      padding: 4px;
      margin-bottom: 2rem;
    }

    #view-toggle button {
      flex: 1;
      background: transparent;
      border: none;
      color: rgba(255,255,255,0.5);
      font-size: 0.9rem;
      font-weight: 500;
      padding: 0.75rem;
      border-radius: 8px;
      cursor: pointer;
    }

    #view-toggle button.active {
      background: rgba(255,255,255,0.1);
      color: #fff;
    }

    /* Views */
    .view {
      display: none;
    }

    .view.active {
      display: block;
    }

    /* Date Row */
    #date-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    #date-row label {
      color: rgba(255,255,255,0.5);
      font-size: 0.9rem;
    }

    #date-row input {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.15);
      color: #fff;
      font-family: inherit;
      font-size: 0.9rem;
      padding: 0.5rem 0.75rem;
      border-radius: 6px;
    }

    /* Day Tabs */
    #day-tabs {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    #day-tabs button {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.6);
      font-size: 0.85rem;
      font-weight: 500;
      padding: 0.6rem 1rem;
      border-radius: 8px;
      cursor: pointer;
    }

    #day-tabs button.active {
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      border-color: transparent;
      color: #fff;
    }

    /* Exercise Cards */
    .exercise-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .exercise-card .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .exercise-card .card-header h3 {
      font-size: 1.1rem;
      font-weight: 600;
    }

    .exercise-card .card-header .target {
      background: rgba(139, 92, 246, 0.2);
      color: #a78bfa;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
    }

    .exercise-card .last-session {
      color: rgba(255,255,255,0.5);
      font-size: 0.85rem;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .exercise-card .status {
      font-size: 0.85rem;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }

    .exercise-card .status.good {
      background: rgba(16, 185, 129, 0.1);
      border-left: 3px solid #10b981;
      color: #34d399;
    }

    .exercise-card .status.warn {
      background: rgba(245, 158, 11, 0.1);
      border-left: 3px solid #f59e0b;
      color: #fbbf24;
    }

    .exercise-card .status.neutral {
      background: rgba(255,255,255,0.03);
      border-left: 3px solid rgba(255,255,255,0.2);
      color: rgba(255,255,255,0.6);
    }

    /* Set Inputs */
    .exercise-card .sets-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .exercise-card .set-header {
      display: grid;
      grid-template-columns: 50px 1fr 1fr;
      gap: 1rem;
      padding: 0 0.25rem;
    }

    .exercise-card .set-header.single-col {
      grid-template-columns: 50px 1fr;
    }

    .exercise-card .set-header span {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(255,255,255,0.4);
    }

    .exercise-card .set-row {
      display: grid;
      grid-template-columns: 50px 1fr 1fr;
      gap: 1rem;
      align-items: center;
    }

    .exercise-card .set-row.single-col {
      grid-template-columns: 50px 1fr;
    }

    .exercise-card .set-row .set-num {
      width: 50px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,0.05);
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      color: rgba(255,255,255,0.6);
    }

    .exercise-card .set-row input {
      width: 100%;
      height: 44px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      color: #fff;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 500;
      padding: 0 1rem;
      text-align: center;
    }

    .exercise-card .set-row input:focus {
      outline: none;
      border-color: #8b5cf6;
      background: rgba(139, 92, 246, 0.1);
    }

    .exercise-card .set-row input::placeholder {
      color: rgba(255,255,255,0.25);
    }

    .exercise-card .assist-input {
      margin-bottom: 1rem;
    }

    .exercise-card .assist-input input {
      width: 100%;
      height: 44px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      color: #fff;
      font-family: inherit;
      font-size: 0.9rem;
      padding: 0 1rem;
    }

    .exercise-card .assist-input input:focus {
      outline: none;
      border-color: #8b5cf6;
    }

    /* Save Area */
    #save-area {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 1.5rem;
      background: linear-gradient(to top, #0a0a0b 80%, transparent);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    #save-btn {
      width: 100%;
      max-width: 400px;
      height: 52px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #fff;
      font-weight: 600;
      font-size: 1rem;
      border: none;
      border-radius: 12px;
      cursor: pointer;
    }

    #save-btn.saved {
      background: linear-gradient(135deg, #10b981, #059669);
    }

    #save-buttons {
      display: flex;
      gap: 0.5rem;
      width: 100%;
      max-width: 400px;
    }

    #save-buttons #save-btn {
      flex: 1;
    }

    #cancel-btn {
      padding: 0 1.5rem;
      height: 52px;
      background: transparent;
      color: #a1a1aa;
      font-weight: 500;
      font-size: 0.9rem;
      border: 1px solid #3f3f46;
      border-radius: 12px;
      cursor: pointer;
    }

    #cancel-btn:hover {
      background: #27272a;
      color: #fff;
    }

    #save-note {
      font-size: 0.8rem;
      color: rgba(255,255,255,0.5);
      min-height: 1rem;
    }

    /* History */
    #history-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    #history-empty {
      text-align: center;
      color: rgba(255,255,255,0.4);
      padding: 3rem;
      display: none;
    }

    #history-empty.show {
      display: block;
    }

    .history-item {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .history-item .date {
      font-weight: 600;
    }

    .history-item .day-type {
      font-size: 0.85rem;
      color: rgba(255,255,255,0.5);
      margin-top: 0.25rem;
    }

    .history-item .badge {
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.4rem 0.75rem;
      border-radius: 20px;
    }
  </style>

  <script>
    const DAYS = {
      upperA: {
        label: 'Upper A',
        exercises: [
          { id: 'ua-bench', name: 'Bench Press', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'ua-latpull', name: 'Lat Pulldown', sets: 3, min: 10, max: 12, type: 'weight' },
          { id: 'ua-shoulderpress', name: 'DB Shoulder Press', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'ua-row', name: 'Chest-Supported Row', sets: 3, min: 10, max: 12, type: 'weight' },
          { id: 'ua-latraise', name: 'Cable Lateral Raise', sets: 2, min: 12, max: 15, type: 'weight' },
          { id: 'ua-curl', name: 'Bicep Curl', sets: 2, min: 10, max: 12, type: 'weight' },
          { id: 'ua-pushdown', name: 'Tricep Pushdown', sets: 2, min: 10, max: 12, type: 'weight' },
        ]
      },
      lowerA: {
        label: 'Lower A',
        exercises: [
          { id: 'la-squat', name: 'Barbell Back Squat', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'la-rdl', name: 'Romanian Deadlift', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'la-legpress', name: 'Leg Press', sets: 2, min: 10, max: 12, type: 'weight' },
          { id: 'la-legcurl', name: 'Leg Curl', sets: 3, min: 10, max: 12, type: 'weight' },
          { id: 'la-calf', name: 'Standing Calf Raise', sets: 3, min: 12, max: 15, type: 'weight' },
          { id: 'la-plank', name: 'Weighted Plank', sets: 2, min: 30, max: 45, type: 'time' },
        ]
      },
      upperB: {
        label: 'Upper B',
        exercises: [
          { id: 'ub-incline', name: 'Incline DB Press', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'ub-cablerow', name: 'Seated Cable Row', sets: 3, min: 10, max: 12, type: 'weight' },
          { id: 'ub-machinepress', name: 'Machine Shoulder Press', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'ub-pullup', name: 'Pull-Ups', sets: 3, min: 6, max: 12, type: 'bodyweight' },
          { id: 'ub-reardelt', name: 'Rear Delt Fly', sets: 2, min: 12, max: 15, type: 'weight' },
          { id: 'ub-hammer', name: 'Hammer Curl', sets: 2, min: 10, max: 12, type: 'weight' },
          { id: 'ub-tricepext', name: 'Overhead Tricep Ext', sets: 2, min: 10, max: 12, type: 'weight' },
        ]
      },
      lowerB: {
        label: 'Lower B',
        exercises: [
          { id: 'lb-deadlift', name: 'Deadlift', sets: 3, min: 6, max: 8, type: 'weight' },
          { id: 'lb-frontsquat', name: 'Front / Goblet Squat', sets: 3, min: 8, max: 10, type: 'weight' },
          { id: 'lb-lunge', name: 'Walking Lunges', sets: 2, min: 10, max: 12, type: 'weight' },
          { id: 'lb-legext', name: 'Leg Extension', sets: 3, min: 10, max: 12, type: 'weight' },
          { id: 'lb-seatedcalf', name: 'Seated Calf Raise', sets: 3, min: 12, max: 15, type: 'weight' },
          { id: 'lb-kneeraise', name: 'Hanging Knee Raise', sets: 2, min: 10, max: 15, type: 'bodyweight' },
        ]
      },
    };

    let pin = sessionStorage.getItem('workout-pin') || '';
    let log = {};
    let loadFailed = false;
    let activeDay = 'upperA';
    let editingDate = null; // null = new entry, string = editing that date

    const pinScreen = document.getElementById('pin-screen');
    const pinInput = document.getElementById('pin-input');
    const pinSubmit = document.getElementById('pin-submit');
    const pinError = document.getElementById('pin-error');
    const app = document.getElementById('app');
    const tabsEl = document.getElementById('day-tabs');
    const exEl = document.getElementById('exercises');
    const dateInput = document.getElementById('workout-date');
    const saveBtn = document.getElementById('save-btn');
    const cancelBtn = document.getElementById('cancel-btn');
    const noteEl = document.getElementById('save-note');
    const historyList = document.getElementById('history-list');
    const historyEmpty = document.getElementById('history-empty');
    const viewBtns = document.querySelectorAll('#view-toggle button');
    const logView = document.getElementById('log-view');
    const historyView = document.getElementById('history-view');

    async function checkAuth() {
      if (!pin) return false;
      try {
        const res = await fetch('/api/workout', { headers: { 'x-workout-pin': pin } });
        return res.ok;
      } catch { return false; }
    }

    async function loadLog() {
      try {
        const res = await fetch('/api/workout', { headers: { 'x-workout-pin': pin } });
        if (!res.ok) throw new Error();
        const data = await res.json();
        log = data.value ? (typeof data.value === 'string' ? JSON.parse(data.value) : data.value) : {};
        loadFailed = false;
      } catch {
        log = {};
        loadFailed = true;
        noteEl.textContent = 'Could not load data — click Retry to try again.';
        noteEl.style.color = '#ef4444';
        saveBtn.textContent = 'Retry';
        saveBtn.style.opacity = '0.8';
      }
      render();
      renderHistory();
    }

    async function saveLog() {
      try {
        const res = await fetch('/api/workout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-workout-pin': pin },
          body: JSON.stringify({ value: JSON.stringify(log) })
        });
        if (!res.ok) throw new Error();
        return true;
      } catch {
        noteEl.textContent = 'Could not save — try again.';
        return false;
      }
    }

    function lastEntry(exId) {
      const arr = log[exId];
      return arr && arr.length ? arr[arr.length - 1] : null;
    }

    function entryForDate(exId, date) {
      const arr = log[exId];
      if (!arr) return null;
      return arr.find(e => e.date === date) || null;
    }

    function formatLast(ex, entry) {
      if (!entry) return 'No previous session';
      const parts = entry.sets.map(s => {
        if (ex.type === 'weight') return `${s.weight || '–'} × ${s.reps || '–'}`;
        if (ex.type === 'bodyweight') return `${s.reps || '–'}${entry.assist ? ` (+${entry.assist}lb)` : ''}`;
        return `${s.secs || '–'}s`;
      });
      return `Last (${entry.date}): ${parts.join(', ')}`;
    }

    function computeStatus(ex, entry) {
      if (!entry) return { text: 'Pick a weight you can hit the low end with 1-2 reps in reserve.', level: 'neutral' };
      const metrics = entry.sets.map(s => ex.type === 'time' ? Number(s.secs) : Number(s.reps)).filter(n => !isNaN(n));
      if (!metrics.length) return { text: 'No sets recorded last time.', level: 'neutral' };
      if (metrics.every(m => m >= ex.max)) {
        const bump = ex.type === 'time' ? 'add 5-10s' : (ex.type === 'bodyweight' ? 'reduce assist' : 'add ~5lbs');
        return { text: `Hit top of range — ${bump} next time.`, level: 'good' };
      }
      if (metrics.some(m => m < ex.min)) {
        return { text: 'Under range — same load, focus on reps.', level: 'warn' };
      }
      return { text: 'In range — try to add a rep where you can.', level: 'neutral' };
    }

    function render() {
      // Tabs
      tabsEl.innerHTML = '';
      Object.keys(DAYS).forEach(key => {
        const btn = document.createElement('button');
        btn.textContent = DAYS[key].label;
        btn.className = key === activeDay ? 'active' : '';
        btn.onclick = () => { activeDay = key; render(); };
        tabsEl.appendChild(btn);
      });

      // Exercises
      exEl.innerHTML = '';
      DAYS[activeDay].exercises.forEach(ex => {
        const lastEnt = lastEntry(ex.id);
        const editEnt = editingDate ? entryForDate(ex.id, editingDate) : null;
        const status = computeStatus(ex, lastEnt);
        const isSingleCol = ex.type !== 'weight';

        const card = document.createElement('div');
        card.className = 'exercise-card';
        card.dataset.exId = ex.id;
        card.dataset.type = ex.type;

        const targetText = ex.type === 'time' ? `${ex.sets} × ${ex.min}-${ex.max}s` : `${ex.sets} × ${ex.min}-${ex.max}`;

        let html = `
          <div class="card-header">
            <h3>${ex.name}</h3>
            <span class="target">${targetText}</span>
          </div>
          <div class="last-session">${formatLast(ex, lastEnt)}</div>
          <div class="status ${status.level}">${status.text}</div>
        `;

        const assistVal = editEnt?.assist || '';
        if (ex.type === 'bodyweight') {
          html += `<div class="assist-input"><input type="number" placeholder="Added/assist lbs (optional)" data-role="assist" value="${assistVal}" /></div>`;
        }

        html += `<div class="sets-container">`;
        html += `<div class="set-header ${isSingleCol ? 'single-col' : ''}">
          <span>Set</span>
          ${ex.type === 'weight' ? '<span>Weight</span><span>Reps</span>' : ''}
          ${ex.type === 'bodyweight' ? '<span>Reps</span>' : ''}
          ${ex.type === 'time' ? '<span>Seconds</span>' : ''}
        </div>`;

        for (let i = 1; i <= ex.sets; i++) {
          const setData = editEnt?.sets?.[i - 1] || {};
          const wVal = setData.weight || '';
          const rVal = setData.reps || '';
          const sVal = setData.secs || '';

          html += `<div class="set-row ${isSingleCol ? 'single-col' : ''}">
            <div class="set-num">${i}</div>
            ${ex.type === 'weight' ? `
              <input type="number" inputmode="decimal" placeholder="lbs" data-role="weight" data-set="${i}" value="${wVal}" />
              <input type="number" inputmode="numeric" placeholder="reps" data-role="reps" data-set="${i}" value="${rVal}" />
            ` : ''}
            ${ex.type === 'bodyweight' ? `<input type="number" inputmode="numeric" placeholder="reps" data-role="reps" data-set="${i}" value="${rVal}" />` : ''}
            ${ex.type === 'time' ? `<input type="number" inputmode="numeric" placeholder="sec" data-role="secs" data-set="${i}" value="${sVal}" />` : ''}
          </div>`;
        }

        html += `</div>`;
        card.innerHTML = html;
        exEl.appendChild(card);
      });
    }

    function renderHistory() {
      const sessions = [];
      const seenDates = new Set();

      Object.entries(log).forEach(([exId, entries]) => {
        entries.forEach(entry => {
          if (!seenDates.has(entry.date)) {
            seenDates.add(entry.date);
            const dayKey = Object.keys(DAYS).find(k => DAYS[k].exercises.some(e => e.id === exId));
            sessions.push({ date: entry.date, dayKey: dayKey || '', dayLabel: dayKey ? DAYS[dayKey].label : 'Workout' });
          }
        });
      });

      sessions.sort((a, b) => new Date(b.date) - new Date(a.date));

      if (!sessions.length) {
        historyList.innerHTML = '';
        historyEmpty.classList.add('show');
        return;
      }

      historyEmpty.classList.remove('show');
      historyList.innerHTML = sessions.map(s => {
        const d = new Date(s.date + 'T00:00:00');
        const formatted = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
        return `
          <div class="history-item" data-date="${s.date}" data-day="${s.dayKey}">
            <div>
              <div class="date">${formatted}</div>
              <div class="day-type">${s.dayLabel}</div>
            </div>
            <span class="badge">Edit</span>
          </div>
        `;
      }).join('');

      historyList.querySelectorAll('.history-item').forEach(item => {
        item.style.cursor = 'pointer';
        item.onclick = () => loadForEdit(item.dataset.date, item.dataset.day);
      });
    }

    function loadForEdit(date, dayKey) {
      editingDate = date;
      if (dayKey && DAYS[dayKey]) activeDay = dayKey;
      dateInput.value = date;
      switchView('log');
      render();
      noteEl.textContent = `Editing workout from ${date}`;
      noteEl.style.color = '#f59e0b';
      saveBtn.textContent = 'Update Workout';
      cancelBtn.style.display = 'block';
    }

    function cancelEdit() {
      editingDate = null;
      dateInput.value = new Date().toISOString().slice(0, 10);
      noteEl.textContent = '';
      noteEl.style.color = '';
      saveBtn.textContent = 'Log Workout';
      cancelBtn.style.display = 'none';
      render();
    }

    function switchView(view) {
      viewBtns.forEach(btn => btn.classList.toggle('active', btn.dataset.view === view));
      logView.classList.toggle('active', view === 'log');
      historyView.classList.toggle('active', view === 'history');
    }

    async function showApp() {
      pinScreen.style.display = 'none';
      app.classList.add('active');
      dateInput.value = new Date().toISOString().slice(0, 10);
      await loadLog();
    }

    viewBtns.forEach(btn => btn.addEventListener('click', () => switchView(btn.dataset.view)));

    cancelBtn.addEventListener('click', cancelEdit);

    dateInput.addEventListener('change', () => {
      if (editingDate && dateInput.value !== editingDate) {
        editingDate = null;
        noteEl.textContent = '';
        noteEl.style.color = '';
        saveBtn.textContent = 'Log Workout';
        cancelBtn.style.display = 'none';
      }
    });

    pinSubmit.addEventListener('click', async () => {
      pin = pinInput.value;
      if (!pin) { pinError.textContent = 'Enter a PIN'; return; }
      pinError.textContent = 'Checking...';
      if (await checkAuth()) {
        sessionStorage.setItem('workout-pin', pin);
        showApp();
      } else {
        pinError.textContent = 'Invalid PIN';
      }
    });

    pinInput.addEventListener('keydown', e => { if (e.key === 'Enter') pinSubmit.click(); });

    saveBtn.addEventListener('click', async () => {
      if (loadFailed) {
        noteEl.textContent = 'Retrying...';
        noteEl.style.color = '';
        await loadLog();
        if (!loadFailed) {
          saveBtn.textContent = 'Log Workout';
          saveBtn.style.opacity = '';
          noteEl.textContent = 'Data loaded! You can log workouts now.';
        }
        return;
      }
      const date = dateInput.value || new Date().toISOString().slice(0, 10);
      let loggedAny = false;

      document.querySelectorAll('.exercise-card').forEach(card => {
        const exId = card.dataset.exId;
        const type = card.dataset.type;
        const sets = [];
        let assist = null;

        if (type === 'bodyweight') {
          const ai = card.querySelector('[data-role=assist]');
          if (ai && ai.value) assist = ai.value;
        }

        card.querySelectorAll('.set-row').forEach(row => {
          if (type === 'weight') {
            const w = row.querySelector('[data-role=weight]').value;
            const r = row.querySelector('[data-role=reps]').value;
            if (w || r) sets.push({ weight: w, reps: r });
          } else if (type === 'bodyweight') {
            const r = row.querySelector('[data-role=reps]').value;
            if (r) sets.push({ reps: r });
          } else {
            const s = row.querySelector('[data-role=secs]').value;
            if (s) sets.push({ secs: s });
          }
        });

        if (sets.length) {
          loggedAny = true;
          if (!log[exId]) log[exId] = [];

          // If editing, remove old entry for this date first
          if (editingDate) {
            log[exId] = log[exId].filter(e => e.date !== editingDate);
          }

          const entry = { date, sets };
          if (assist) entry.assist = assist;
          log[exId].push(entry);
        } else if (editingDate && log[exId]) {
          // If editing and no sets filled, remove old entry
          log[exId] = log[exId].filter(e => e.date !== editingDate);
        }
      });

      if (!loggedAny && !editingDate) { noteEl.textContent = 'Fill in at least one set.'; return; }

      const wasEditing = editingDate;
      if (await saveLog()) {
        saveBtn.classList.add('saved');
        saveBtn.textContent = wasEditing ? 'Updated!' : 'Logged!';
        noteEl.textContent = `${wasEditing ? 'Updated' : 'Saved'} ${DAYS[activeDay].label} for ${date}`;
        noteEl.style.color = '';
        editingDate = null;
        cancelBtn.style.display = 'none';
        setTimeout(() => {
          saveBtn.classList.remove('saved');
          saveBtn.textContent = 'Log Workout';
        }, 1500);
        render();
        renderHistory();
      }
    });

    (async () => {
      if (pin && await checkAuth()) {
        showApp();
      } else {
        sessionStorage.removeItem('workout-pin');
        pin = '';
      }
    })();
  </script>
</body>
</html>
